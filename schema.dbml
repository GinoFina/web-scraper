// ===============================
// TABLAS MAESTRAS (CATÁLOGOS)
// ===============================

Table COUNTRIES {
  country_alpha2 varchar [primary key]
  name varchar [not null]
}

Table TEAMS {
  team_id integer [primary key]
  name varchar [not null]
}

Table TOURNAMENTS {
  tournament_id integer [primary key]
  name varchar [not null]
  multiplier float [note: 'Ej: 1.0 para Premier, 0.97 para España']
}

Table SEASONS {
  season_id integer [primary key]
  name varchar [not null]
  year varchar
}

// ===============================
// TABLAS PRINCIPALES
// ===============================

Table PLAYERS {
  player_id integer [primary key]
  name varchar [not null]
  team_id integer
  country_alpha2 varchar
  position varchar [note: 'Posición general (D, M, F, G)']
  specific_position varchar [note: 'Ej: LB/LM']
  age integer
  updated_at timestamp [default: `now()`]
}

Table TRACKED_LEAGUES {
  id integer [primary key]
  tournament_id integer [not null]
  season_id integer [not null]
  url varchar [not null, unique]
  accumulation varchar [default: 'total', note: 'Configuración de qué se debe scrapear']
  added_at timestamp [default: `now()`]
  last_updated timestamp
}

// ===============================
// DATOS ESTADÍSTICOS (FACT TABLE)
// ===============================

Table SEASON_STATS {
  id integer [primary key]
  player_id integer [not null]
  tournament_id integer [not null]
  season_id integer [not null]
  team_id integer
  team_name varchar
  accumulation varchar [default: 'total', note: 'total, perGame, per90']
  fetched_at timestamp [default: `now()`]
  
  // Generales
  appearances integer
  minutes_played integer
  goals integer
  assists integer
  rating float
  
  // Pases y Creación
  accurate_passes integer
  key_passes integer
  big_chances_created integer
  accurate_long_balls integer
  total_long_balls integer
  accurate_crosses integer
  
  // Derivados de Pases
  accurate_passes_pct float
  accurate_long_balls_pct float
  accurate_crosses_pct float
  total_passes integer
  total_crosses integer
  
  // Tiros y Finalización
  penalty_goals integer
  shots_on_target integer
  shots_off_target integer
  blocked_scoring_attempt integer
  big_chances_missed integer
  total_shots integer
  
  // Regates
  dribbles_won integer
  dribbles_attempted integer
  dribbles_won_pct float
  
  // Duelos Aéreos y Terrestres
  aerial_duels_won integer
  aerial_duels_total integer
  aerial_duels_won_pct float
  ground_duels_won integer
  ground_duels_total integer
  ground_duels_won_pct float
  
  // Duelos Totales (Del script V2)
  total_duels_won integer
  total_duels_won_pct float
  
  // Defensa (Del script V2)
  tackles integer
  interceptions integer
  clearances integer
  blocked_shots integer
  dispossessed integer
  offsides integer
  possession_lost integer
  
  // Arqueros (Se mantienen por completitud de BD, aunque los ignores en UI)
  clean_sheets integer
  saves_inside_box integer
  saves_outside_box integer
  goals_conceded integer
  goals_conceded_inside_box integer
  goals_conceded_outside_box integer
  penalties_saved integer
  punches integer
  high_claims integer
  runs_out integer
  successful_runs_out integer
  saves integer

  Indexes {
    // Índice compuesto restaurado para prevenir colisiones
    (player_id, tournament_id, season_id, accumulation) [unique]
  }
}

// ===============================
// EVALUACIÓN (ALGORITMO DE SCOUTING)
// ===============================

Table PLAYER_EVALUATIONS {
  id integer [primary key]
  stats_id integer [not null, note: 'FK a SEASON_STATS']
  role varchar [note: 'Ej: Creative Full-Back']
  role_score float
  league_score float
  world_score float
  calculated_at timestamp [default: `now()`]
  
  Indexes {
    (stats_id, role) [unique]
  }
}

// ===============================
// TABLA DE RESPALDO (AISLADA)
// ===============================

Table RAW_STATS_BACKUP {
  id integer [primary key]
  player_id integer [not null]
  tournament_id integer [not null]
  season_id integer [not null]
  raw_json text [not null]
  fetched_at timestamp [default: `now()`]
}

// ===============================
// RELACIONES (FOREIGN KEYS)
// ===============================

Ref: PLAYERS.team_id > TEAMS.team_id
Ref: PLAYERS.country_alpha2 > COUNTRIES.country_alpha2

Ref: TRACKED_LEAGUES.tournament_id > TOURNAMENTS.tournament_id
Ref: TRACKED_LEAGUES.season_id > SEASONS.season_id

Ref: SEASON_STATS.player_id > PLAYERS.player_id
Ref: SEASON_STATS.tournament_id > TOURNAMENTS.tournament_id
Ref: SEASON_STATS.season_id > SEASONS.season_id

Ref: PLAYER_EVALUATIONS.stats_id > SEASON_STATS.id

Ref: RAW_STATS_BACKUP.player_id > PLAYERS.player_id
Ref: RAW_STATS_BACKUP.tournament_id > TOURNAMENTS.tournament_id
Ref: RAW_STATS_BACKUP.season_id > SEASONS.season_id